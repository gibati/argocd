apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: podinfo-v1
  namespace: argocd
spec:
  project: default

  source:
    repoURL: https://stefanprodan.github.io/podinfo
    chart: podinfo
    targetRevision: "*"
    helm:
      values: |
        replicaCount: 1

        ui:
          color: "#ffff00"
          message: "version 1.0.0"

  destination:
    server: https://kubernetes.default.svc
    namespace: podinfo-v1

  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
