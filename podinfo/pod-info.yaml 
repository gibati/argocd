apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: podinfo-v1
  namespace: argocd
spec:
  project: default
  source:
    repoURL: https://stefanprodan.github.io/podinfo
    chart: podinfo
    targetRevision: 6.6.3
    helm:
      values: |
        replicaCount: 1

        image:
          tag: 6.6.3

        ui:
          color: "#0000ff"
          message: "version 1.0.0"

        service:
          type: ClusterIP

  destination:
    server: https://kubernetes.default.svc
    namespace: podinfo-v1

  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
