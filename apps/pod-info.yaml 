apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: pod-info
  namespace: argocd
spec:
  project: default

  source:
    repoURL: git@github.com:gibati/argocd.git
    targetRevision: HEAD
    path: podinfo  

  destination:
    server: https://kubernetes.default.svc
    namespace: apps  

  syncPolicy:
    automated:
      prune: true
      selfHeal: true
